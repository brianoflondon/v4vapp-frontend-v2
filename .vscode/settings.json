{
  "editor.bracketPairColorization.enabled": true,
  "editor.guides.bracketPairs": true,
  "editor.formatOnSave": true,
  "editor.defaultFormatter": "esbenp.prettier-vscode",
  "editor.codeActionsOnSave": ["source.fixAll.eslint"],
  "eslint.validate": ["javascript", "javascriptreact", "typescript", "vue"],
  "workbench.colorCustomizations": {
    "activityBar.background": "#fe90008c",
    "titleBar.activeBackground": "#FE9200",
    "titleBar.activeForeground": "#010508",
    "titleBar.inactiveBackground": "#8A4E00",
    "titleBar.inactiveForeground": "#FFFAF3",
    "statusBar.background": "#8A4E00",
    "statusBar.foreground": "#FFFAF3",
    "statusBar.debuggingBackground": "#8A4E00",
    "statusBar.debuggingForeground": "#FFFAF3",
    "statusBar.noFolderBackground": "#8A4E00",
    "statusBar.noFolderForeground": "#FFFAF3"
  },
  "cSpell.words": [
    "axios",
    "codabar",
    "databar",
    "fontawesome",
    "intlify",
    "mymap",
    "paywithsats",
    "pinia",
    "themify"
  ],
  "githubPullRequests.ignoredPullRequestBranches": ["develop"],
  "i18n-ally.localesPaths": ["src/i18n/*"],
  "i18n-ally.sourceLanguage": "en",
  "i18n-ally.namespace": false,
  "[python]": {
    "editor.defaultFormatter": "ms-python.black-formatter"
  },
  "python.formatting.provider": "none"
}
