{
  "version": "0.2.0",
  "configurations": [
    {
      "type": "chrome",
      "request": "launch",
      "name": "PWA: chrome",
      "url": "https://localhost:9200/",
      "webRoot": "${workspaceFolder}/src",
      "sourceMapPathOverrides": {
        "webpack://quasar-project/./src/*": "${webRoot}/*"
      },
      "skipFiles": [
        "<node_internals>/**"
      ],
      "runtimeArgs": [
        "--allow-insecure-localhost"
      ]
    },
    {
      "type": "chrome",
      "request": "launch",
      "name": "Quasar App: chrome",
      "url": "https://localhost:9200",
      "webRoot": "${workspaceFolder}/src",
      "runtimeArgs": [
        "--allow-insecure-localhost"
      ],
      "sourceMapPathOverrides": {
        "webpack://quasar-project/./src/*": "${webRoot}/*"
      }
    }
  ]
}
